{
  "name": "asset-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./services/*\" --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @am/browser-runtime typecheck && pnpm --filter web typecheck",
    "test": "vitest run",
    "migrate": "pnpm -r --filter \"./services/*\" migrate",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.25.12",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@am/demo-seed": "workspace:*"
  }
}
