{
  "name": "asset-management",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "dev": "bun run --filter './services/*' --filter web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --filter @am/browser-runtime typecheck && bun run --filter web typecheck",
    "test": "bun test",
    "migrate": "bun run --filter './services/*' migrate",
    "seed": "bun scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@am/demo-seed": "workspace:*",
    "@types/bun": "^1.3.0"
  }
}
