# Local development defaults (docker compose up -d postgres minio mailpit).
# Copy to .env; each service reads only the keys it needs.

# Where the services run:
#   server   (default) the four services run as processes; the web app talks to them
#   browser  no backend: the same services run inside the browser (service worker + PGlite)
VITE_RUNTIME=server
NODE_ENV=development
LOG_LEVEL=info
MIGRATE_ON_START=true
# Administrators can download a backup of all data and restore one (Administration → Backup & restore). On by default.
# BACKUP_ENABLED=true

DATABASE_URL=postgres://postgres:postgres@localhost:5432/assets
PUBLIC_URL=http://localhost:5173
AUTH_JWKS_URL=http://localhost:4001/api/identity/.well-known/jwks.json

# identity
# Sign-in methods: any of manual (admins add people with passwords), ldap, adfs — e.g. manual or ldap,adfs.
# Unset: LOCAL_AUTH_ENABLED / LDAP_ENABLED / OIDC_ENABLED decide.
# AUTH_MODE=manual
COOKIE_SECRET=dev-only-cookie-secret-change-me-0123456789
COOKIE_SECURE=false
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin-change-me
LDAP_ENABLED=false
OIDC_ENABLED=false
# What a directory sign-in brings in: the shown name, and further names people can be searched by
# (people pickers and asset search also match username and email). These are the defaults.
# LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# LDAP_NAME_ATTRIBUTES=givenName,sn,cn,name,userPrincipalName
# OIDC_DISPLAY_NAME_CLAIM=unique_name
# OIDC_NAME_CLAIMS=given_name,family_name,name,upn

# files
REGISTRY_URL=http://localhost:4002
S3_BUCKET=assets
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# When the nightly backup to S3 runs, once an administrator switched it on (cron, UTC). Default 01:00.
# BACKUP_NIGHTLY_CRON=0 1 * * *

# scheduler
# Email is off unless this is "on": no reminder, invite or notification leaves the app.
# EMAIL_SENDING=on
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Assets <assets@example.local>
REMINDER_TIMEZONE=UTC
REQUEST_INBOX_EMAILS=procurement@example.local

# Observability (opt-in): `docker compose --profile observability up -d`, then set
# METRICS_ENABLED=true (VictoriaMetrics scrapes :4001-4004/metrics) and OTEL_ENABLED=true.
LOG_FORMAT=json
METRICS_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on

# Serverless (Vercel, VITE_RUNTIME=server): see README "Serverless on Vercel". Every variable
# the function and its build read; the kit sets them on Vercel, `vercel env pull` brings dev's here.
#
# Environment: production, dev or preview. Set means deployed: the settings below are required,
# migrations run only at deploy time, and secrets are never generated.
# APP_ENV=
# Direct Postgres connection (each service pins its schema per connection). Locally DATABASE_URL works too.
# DATABASE_URL_UNPOOLED=
# Bucket for documents, its region, and the key prefix of this environment (empty in production).
# S3_BUCKET=
# S3_REGION=
# S3_PREFIX=
# IAM role the function assumes with its Vercel OIDC token. Unset: S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY or the default AWS chain.
# S3_ROLE_ARN=
# Token signing key: a random secret (the P-256 key is derived from it) or a PKCS#8 PEM. Unset locally: generated and kept in the database.
# AUTH_SIGNING_KEY=
# Session cookie secret, 32+ characters. Unset locally: generated and kept in the database.
# COOKIE_SECRET=
# Production only: Vercel Cron sends it to /api/cron, which refuses calls without it.
# CRON_SECRET=
# Password of the first administrator (12+ characters), user name `admin` unless LOCAL_ADMIN_USERNAME is set.
# LOCAL_ADMIN_PASSWORD=
# LOCAL_ADMIN_USERNAME=
# The first administrator's email, so they can also sign in with Google.
# LOCAL_ADMIN_EMAIL=
# Sign-in methods: manual, ldap, adfs, google or a comma-separated mix (e.g. manual,google). Unset: manual.
# AUTH_MODE=
# Google sign-in: the OAuth client. Its redirect URIs are <origin>/api/auth/callback/google for production, dev and localhost.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Signs Google's `state`; dev and previews share it. Unset locally: COOKIE_SECRET.
# AUTH_SECRET=
# This deployment's origin for Google sign-in: production and dev only. Unset: APP_URL.
# AUTH_URL=
# Dev and previews: `https://<dev domain>/api/auth`. Google returns there and dev forwards previews back to themselves.
# AUTH_REDIRECT_PROXY_URL=
# Outgoing mail (smtp:// or smtps://) and its sender. Unset: nothing is sent and reminders wait.
# SMTP_URL=
# MAIL_FROM=
# Public origin for links in emails and sign-in redirects: production and dev only. Unset (previews):
# https://VERCEL_BRANCH_URL, else https://VERCEL_URL. VERCEL_URL and VERCEL_PROJECT_NAME also give the team's
# preview host suffix that may finish Google sign-in through dev.
# APP_URL=
# Local runs only (no APP_ENV), when APP_URL is unset.
# PUBLIC_URL=
# Build only: build the serverless function (`server`) or the in-browser app (`browser`, the default).
# VITE_RUNTIME=
# Build only: when Vercel Cron runs reminders. Unset: 06:00 and 18:00 UTC.
# REMINDER_CRON=
# Web dev only: send all of /api to `bun run --filter @am/serverless dev` (e.g. http://localhost:3000).
# VITE_API_URL=
# Local serverless runtime port. Unset: 3000.
# PORT=
