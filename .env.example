# Local development defaults (docker compose up -d postgres minio mailpit).
# Copy to .env; each service reads only the keys it needs.

# Where the services run:
#   server   (default) the four services run as processes; the web app talks to them
#   browser  no backend: the same services run inside the browser (service worker + PGlite)
VITE_RUNTIME=server
NODE_ENV=development
LOG_LEVEL=info
MIGRATE_ON_START=true

DATABASE_URL=postgres://postgres:postgres@localhost:5432/assets
PUBLIC_URL=http://localhost:5173
AUTH_JWKS_URL=http://localhost:4001/api/identity/.well-known/jwks.json

# identity
# Sign-in methods: any of manual (admins add people with passwords), ldap, adfs — e.g. manual or ldap,adfs.
# Unset: LOCAL_AUTH_ENABLED / LDAP_ENABLED / OIDC_ENABLED decide.
# AUTH_MODE=manual
COOKIE_SECRET=dev-only-cookie-secret-change-me-0123456789
COOKIE_SECURE=false
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin-change-me
LDAP_ENABLED=false
OIDC_ENABLED=false

# files
REGISTRY_URL=http://localhost:4002
S3_BUCKET=assets
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# scheduler
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Assets <assets@example.local>
REMINDER_TIMEZONE=UTC
REQUEST_INBOX_EMAILS=procurement@example.local

# Observability (opt-in): `docker compose --profile observability up -d`, then set
# METRICS_ENABLED=true (VictoriaMetrics scrapes :4001-4004/metrics) and OTEL_ENABLED=true.
LOG_FORMAT=json
METRICS_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on

# Serverless (Vercel): see README "Serverless on Vercel". The integrations provide the database and bucket.
# VITE_API_URL=http://localhost:3000   # web dev: send all of /api to `bun run --filter @am/serverless dev`
# CRON_SECRET=                         # Vercel sends it with cron calls to /api/cron
# REMINDER_CRON=0 6,18 * * *           # when Vercel Cron runs reminders (build time)
